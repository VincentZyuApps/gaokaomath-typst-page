{
  "name": "gaokaomath-typst-page",
  "version": "1.0.0",
  "description": "基于 Typst 与 VitePress 的历年全国高考数学真题现代排版与沉浸式在线题库",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs --port 61952",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs --port 61952",
    "convert": "node scripts/converter.mjs",
    "compile:pdf": "typst compile --root . papers/2024/new_gaokao_1.typ papers/2024/new_gaokao_1.pdf"
  },
  "keywords": [
    "gaokao",
    "math",
    "typst",
    "vitepress",
    "exam"
  ],
  "author": "VincentZyu",
  "license": "CC-BY-4.0",
  "devDependencies": {
    "markdown-it-mathjax3": "^4.3.2",
    "vitepress": "^1.6.4"
  }
}
