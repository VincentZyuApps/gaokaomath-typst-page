当 $0 (1 - a)^(b)$], [$(1 + a)^(a) > (1 + b)^(b)$], [$(1 - a)^(b) > (1 - a)^((b)/(2))$], [$(1 - a)^(a) > (1 - b)^(b)$], cols: 1)
]

