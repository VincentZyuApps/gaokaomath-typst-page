#align(center)[#image("/papers/2009/img/new_curriculum_liberal/q3_fig1.png", width: 68%)]
  #choices([变量 $x$ 与 $y$ 正相关，$u$ 与 $v$ 正相关], [变量 $x$ 与 $y$ 正相关，$u$ 与 $v$ 负相关], [变量 $x$ 与 $y$ 负相关，$u$ 与 $v$ 正相关], [变量 $x$ 与 $y$ 负相关，$u$ 与 $v$ 负相关], cols: 2)
]

