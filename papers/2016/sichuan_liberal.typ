#part-header("单选题")

#problem(1)[
设 $i$ 为虚数单位，则复数 $( 1+ i )^2=$（ ）
  #choices([$0$], [$2$], [$2 i$], [$2+2 i$], cols: 4)
]

#answer([C])

#solution[
由 $i ""^2=-1$，得 $(1+ i )^2=1+2 i + i ""^2=2 i$，故选 C.
]

#problem(2)[
设集合 $A=\{x | 1 <= x <= 5 \}$，$ZZ$ 为整数集，则集合 $A inter ZZ$ 中元素的个数是（ ）
  #choices([$6$], [$5$], [$4$], [$3$], cols: 4)
]

#answer([B])

#solution[
由 $1 <= x <= 5$ 且 $x in ZZ$，得 $A inter ZZ =\{1,2,3,4,5\}$，共有 $5$ 个元素，故选 B.
]

#problem(3)[
抛物线 $y^2=4 x$ 的焦点坐标是（ ）
  #choices([$(0,2)$], [$(0,1)$], [$(2,0)$], [$(1,0)$], cols: 4)
]

#answer([D])

#solution[
抛物线的标准方程为 $y^2=2 p x$，与 $y^2=4 x$ 对比得 $p=2$，其焦点为 $((p)/(2),0)=(1,0)$，故选 D.
]

#problem(4)[
为了得到函数 $y= sin (x+(pi)/(3))$ 的图象，只需把函数 $y= sin x$ 的图象上所有的点（ ）
  #choices([向左平行移动 $(pi)/(3)$ 个单位长度], [向右平行移动 $(pi)/(3)$ 个单位长度], [向上平行移动 $(pi)/(3)$ 个单位长度], [向下平行移动 $(pi)/(3)$ 个单位长度], cols: 2)
]

#answer([A])

#solution[
将 $y= sin x$ 中的自变量 $x$ 换为 $x+(pi)/(3)$，图象向左平移 $(pi)/(3)$ 个单位长度后，函数值在横坐标为 $x$ 处变为 $sin (x+(pi)/(3))$，故选 A.
]

#problem(5)[
设 $p$：实数 $x$，$y$ 满足 $x>1$ 且 $y>1$，$q$：实数 $x$，$y$ 满足 $x+y>2$，则 $p$ 是 $q$ 的（ ）
  #choices([充分不必要条件], [必要不充分条件], [充要条件], [既不充分也不必要条件], cols: 4)
]

#answer([A])

#solution[
若命题 $p$ 成立，则 $x>1$，$y>1$，从而 $x+y>2$，所以 $p$ 是 $q$ 的充分条件. 取 $x=(3)/(2)$，$y=(1)/(2)$，有 $x+y=2$ 不满足 $q$；改取 $x=(3)/(2)$，$y=1$，有 $x+y=(5)/(2)>2$，但 $y>1$ 不成立，所以 $q$ 不是 $p$ 的充分条件. 故选 A.
]

#problem(6)[
已知 $a$ 为函数 $f(x)=x^3-12 x$ 的极小值点，则 $a=$（ ）
  #choices([$-4$], [$-2$], [$4$], [$2$], cols: 4)
]

#answer([D])

#solution[
$f'(x)=3 x^2-12=3(x-2)(x+2)$. 当 $x<-2$ 或 $x>2$ 时，$f'(x)>0$；当 $-2<x<2$ 时，$f'(x)<0$. 因此 $x=-2$ 是极大值点，$x=2$ 是极小值点，故选 D.
]

#problem(7)[
公司为激励创新，计划逐年加大研发资金投入. 若该公司 2015 年全年投入研发资金 130 万元，在此基础上，每年投入的研发资金比上一年增长 $12\%$，则该公司全年投入的研发资金开始超过 200 万元的年份是（ ）

（参考数据：$\l g 1.12 approx 0 .05$，$\l g 1.3 approx 0 .11$，$\l g 2 approx 0 .30$）
  #choices([$2018$ 年], [$2019$ 年], [$2020$ 年], [$2021$ 年], cols: 4)
]

#answer([B])

#solution[
设从 $2015$ 年起经过 $n$ 年后的全年投入为 $T_n$，则 $T_n=130 times 1 .12^n$. 开始超过 $200$ 万元需满足
$130 times 1 .12^n>200$，即
$n>(\l g 2-\l g 1.3)/(\l g 1.12) approx (0.30-0.11)/(0.05)=3.8$.
因为 $n$ 为整数，最小值为 $4$，对应年份为 $2015+4=2019$ 年，故选 B.
]

#problem(8)[
秦九韶是我国南宋时期的数学家，普州（现四川省安岳县）人，他在所著的《数书九章》中提出的多项式求值的秦九韶算法，至今仍是比较先进的算法. 如图所示的程序框图给出了利用秦九韶算法求某多项式值的一个实例，若输入 $n$，$x$ 的值分别为 $3,2$，则输出 $v$ 的值为（ ）


#align(center)[#image("/papers/2016/img/sichuan_liberal/q8_fig1.png", width: 45%)]
  #choices([$9$], [$18$], [$20$], [$35$], cols: 4)
]

#answer([B])

#solution[
程序开始时 $v=1$，$i=n-1=2$. 循环三次的计算依次为
$v=1 times 2 +2=4$，$v=4 times 2 +1=9$，$v=9 times 2 +0=18$，随后 $i=-1$，不再满足循环条件，输出 $v=18$，故选 B.
]

#problem(9)[
已知正三角形 $A B C$ 的边长为 $2 sqrt(3)$，平面 $A B C$ 内的动点 $P$，$M$ 满足 $| arrow(A P)|=1$，$arrow(P M)=arrow(M C)$，则 $| arrow(B M)|^2$ 的最大值是（ ）
  #choices([$(43)/(4)$], [$(49)/(4)$], [$(37+6 sqrt(3))/(4)$], [$(37+2 sqrt(33))/(4)$], cols: 2)
]

#answer([B])

#solution[
以 $A$ 为原点，记 $arrow(A B)=bold(b)$，$arrow(A C)=bold(c)$，$arrow(A P)=bold(p)$. 由题意，$|bold(b)|=|bold(c)|=2 sqrt(3)$，$|bold(p)|=1$，且 $bold(b)\c d o t b o l d(c)=|bold(b)| |bold(c)| cos 60 ""^ degree =6$.

由 $arrow(P M)=arrow(M C)$，点 $M$ 是线段 $P C$ 的中点，所以 $arrow(B M)=(bold(p)+bold(c)-2 bold(b))/(2)$. 因此
$|arrow(B M)|^2=(1)/(4)|bold(p)+bold(c)-2 bold(b)|^2$. 又 $|bold(c)-2 bold(b)|^2=12+4 times 12 -4 times 6 =36$，由三角不等式，$|bold(p)+bold(c)-2 bold(b)| <= 1 +6=7$. 当 $bold(p)$ 与 $bold(c)-2 bold(b)$ 同向时取等号，故 $|arrow(B M)|^2$ 的最大值为 $(7^2)/(4)=(49)/(4)$，选 B.
]

#problem(10)[
设直线 $l_1$，$l_2$ 分别是函数 $f(x)=\b e g i n{c a s e s} - ln x,&0<x<1,\\ ln x,&x>1, \e n d{c a s e s}$ 图象上点 $P_1$，$P_2$ 处的切线，$l_1$ 与 $l_2$ 垂直相交于点 $P$，且 $l_1$，$l_2$ 分别与 $y$ 轴相交于点 $A$，$B$，则 $triangle P A B$ 的面积的取值范围是（ ）
  #choices([$(0,1)$], [$(0,2)$], [$(0,+ oo )$], [$(1,+ oo )$], cols: 4)
]

#answer([A])

#solution[
设 $P_1=(t,- ln t)$，其中 $0<t<1$，设 $P_2=(s, ln s)$，其中 $s>1$. 两条切线的斜率分别为 $-(1)/(t)$ 与 $(1)/(s)$. 由两直线垂直，得 $-(1)/(t s)=-1$，所以 $s=(1)/(t)$. 记 $L=- ln t$，则两个切点的纵坐标都为 $L$.

两条切线方程分别为 $l_1:y=-(x)/(t)+L+1$ 和 $l_2:y=t x+L-1$，故它们在 $y$ 轴上的截距为 $A(0,L+1)$，$B(0,L-1)$. 联立两式得交点 $P$ 的横坐标为 $(2 t)/(1+t^2)$，而 $|A B|=2$. 因此
$S_( triangle P A B)=(1)/(2) times 2 times (2 t)/(1+t^2)=(2 t)/(1+t^2)$.

因为 $0<t<1$，有 $0<(2 t)/(1+t^2)<1$，且该函数在 $(0,1)$ 上连续，故面积的取值范围为 $(0,1)$，选 A.
]

